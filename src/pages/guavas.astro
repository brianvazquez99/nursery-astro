---
import guava from '../assets/nursery-guava.jpg';
import '../styles/global.css';
import Layout from "../layouts/Layout.astro"
import { Image } from 'astro:assets';
---

<Layout>
<main class="w-full max-w-6xl mx-auto px-4 py-8 lg:py-12">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">

    <!-- Plant Media Section -->
    <div class="relative w-full aspect-square sm:aspect-[4/3] lg:aspect-square rounded-2xl overflow-hidden shadow-lg border border-slate-100 bg-slate-50">
      <Image
        src={guava}
        alt="Guava tree foliage and fruit"
        class="w-full h-full object-cover object-center"
      />
    </div>

    <!-- Details & Specs Section -->
    <div class="flex flex-col gap-6">

      <!-- Category & Title -->
      <div>
        <span class="text-xs font-semibold tracking-wider text-amber-700 uppercase">Fruit Trees</span>
        <h1 class="text-3xl sm:text-4xl font-bold text-olive-600 tracking-tight mt-1">Guava</h1>
        <p class="text-sm italic text-slate-500 mt-0.5">Psidium guajava</p>
      </div>

      <!-- Pricing Breakdown Cards -->
      <div class="space-y-2">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">Pot Size & Pricing</h2>
        <div class="grid grid-cols-2 gap-3">
          <div class="flex flex-col p-4 rounded-xl border border-olive-200 bg-olive-50/50">
            <span class="text-xs font-medium text-slate-600">3 Gallon Container</span>
            <span class="text-2xl font-bold text-olive-700 mt-1">$30</span>
          </div>
          <div class="flex flex-col p-4 rounded-xl border border-amber-200 bg-amber-50/50">
            <span class="text-xs font-medium text-slate-600">7 Gallon Container</span>
            <span class="text-2xl font-bold text-amber-700 mt-1">$55</span>
          </div>
        </div>
      </div>

      <!-- Varieties Grid -->
      <div class="space-y-3">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">Available Varieties</h2>
        <div class="flex flex-wrap gap-2">
          <span class="px-3.5 py-1.5 bg-slate-100 text-slate-700 rounded-lg text-sm font-medium border border-slate-200 hover:border-olive-500 transition-colors">Ruby</span>
          <span class="px-3.5 py-1.5 bg-slate-100 text-slate-700 rounded-lg text-sm font-medium border border-slate-200 hover:border-olive-500 transition-colors">Supreme</span>

        </div>
      </div>

    </div>
  </div>
</main>

</Layout>
