---
import mangoThumbnail from "../assets/nursery-mango.jpg";
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Image from "astro/components/Image.astro";
import MangoDialog from "../components/MangoDialog.astro";
import { getCollection } from "astro:content";

const inventory = await getCollection("plantInventory");

let mango3Gal = inventory.filter((inv) =>
    inv.data["Plant Name"].toLowerCase().includes("mango-3"),
)[0].data;
let mango7Gal = inventory.filter((inv) =>
    inv.data["Plant Name"].toLowerCase().includes("mango-7"),
)[0].data;
console.log(mango3Gal);

const mangoVarieties = [
    {
        id: "tommy",
        name: "Tommy Atkins",
        description:
            "Commercially produced mango, widely known for its exceptional durability and long shelf life.",
        href: "https://en.wikipedia.org/wiki/Tommy_Atkins_(mango)",
    },
    {
        id: "valencia",
        name: "Valencia Pride",
        description:
            "A large, fast-growing classic Florida mango variety known for its vibrant red-and-yellow skin and sweet, nearly fiberless flesh.",
    },
    {
        id: "glenn",
        name: "Glenn",
        description:
            "A classic, early-season Florida variety known for its rich, sweet flavor and smooth, entirely fiberless flesh.",
    },
    {
        id: "kent",
        name: "Kent",
        description:
            "A large, sweet, fiberless variety of mango known for its rich flavor and juicy, tender flesh.",
        href: "https://www.mango.org/mango-variety/kent/",
    },
    {
        id: "superjuli",
        name: "Super Julie",
        description:
            "A premium, highly flavorful mango variety developed from a Julie mango seedling by breeder Gary Zill in Boynton Beach, Florida.",
    },
    {
        id: "icecream",
        name: "Ice Cream",
        description:
            "A small, dwarf-tree mango variety originating from Trinidad that is famous for its exceptionally smooth, fiberless flesh and sweet flavor reminiscent of mango sorbet.",
    },
    {
        id: "carrie",
        name: "Carrie",
        description:
            "A longtime favorite among mango enthusiasts for its incredibly rich, sweet flavor, buttery texture, and superb disease resistance.",
        href: "https://www.louiesnursery.com/plants/tropical-fruit-trees/mango-trees/carrie-mango/",
    },
    {
        id: "namdocmai",
        name: "Nam Doc Mai",
        description:
            "Originating from Thailand, this mango is known for its exceptional sweetness, silky texture, and use in traditional dishes like Thai mango sticky rice.",
        href: "https://toptropicals.com/cgi-bin/garden_catalog/cat.cgi?script_param=dWlkPU1BTkdPX05BTURPQ01BSQ==&print_page=1",
    },
];
---

<script>
    document
        .querySelectorAll<HTMLButtonElement>("[data-dialog-open]")
        .forEach((button) => {
            button.addEventListener("click", () => {
                document
                    .getElementById(button.dataset.dialogOpen ?? "")
                    ?.showModal();
            });
        });
</script>

<Layout>
    <main class="w-full max-w-6xl mx-auto px-4 py-8 lg:py-12">
        {mangoVarieties.map((variety) => (
            <MangoDialog {...variety} />
        ))}

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">
            <div class="relative w-full aspect-square sm:aspect-[4/3] lg:aspect-square rounded-2xl overflow-hidden shadow-lg border border-slate-100 bg-slate-50">
                <Image
                    src={mangoThumbnail}
                    loading="eager"
                    fetchpriority="high"
                    alt="Mango tree foliage and fruit"
                    class="w-full h-full object-cover object-center"
                />
            </div>

            <div class="flex flex-col gap-6">
                <div>
                    <span class="text-xs font-semibold tracking-wider text-amber-700 uppercase">
                        Fruit Trees
                    </span>
                    <h1 class="text-3xl sm:text-4xl font-bold text-olive-600 tracking-tight mt-1">
                        Mango
                    </h1>
                    <p class="italic text-slate-500 mt-0.5">Mangifera indica</p>
                    <p class="text-sm font-medium italic text-slate-500 mt-0.5">
                        Grown for its large, colorful and delicious fruit, the
                        medium to large evergreen mango tree is also attractive
                        in the home landscape. Its rounded canopy may be low and
                        dense to upright and open, with dark green foliage that
                        is long and narrow.
                    </p>
                </div>

                <div class="space-y-2">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">
                        Pot Size & Pricing
                    </h2>
                    <span class="flex items-center gap-1.5 text-xs text-slate-400">
                        <span
                            class="flex h-5 w-5 items-center justify-center rounded-full bg-olive-50 text-olive-600"
                            aria-hidden="true"
                        >
                            i
                        </span>
                        <span>Approximate availability — please call for more info</span>
                    </span>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="flex min-h-40 flex-col justify-between rounded-xl border border-olive-200 bg-olive-50/50 p-4">
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
                                    Container size
                                </p>
                                <h3 class="mt-1 text-base font-semibold text-slate-700">
                                    3 Gallons
                                </h3>
                            </div>
                            <div class="mt-4 flex items-end justify-between gap-3">
                                <div>
                                    <p class="text-xs font-medium text-slate-500">
                                        Price
                                    </p>
                                    <p class="mt-0.5 text-2xl font-bold text-olive-700">
                                        $30
                                    </p>
                                </div>
                                <div class="text-right">
                                    <p class="text-xs font-medium text-slate-500">
                                        Available
                                    </p>
                                    <p class="mt-1 inline-flex min-w-8 justify-center rounded-full bg-white px-2 py-1 text-sm font-bold text-olive-700 shadow-sm ring-1 ring-olive-200">
                                        {mango3Gal["Current Quantity"]}
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="flex min-h-40 flex-col justify-between rounded-xl border border-amber-200 bg-amber-50/50 p-4">
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
                                    Container size
                                </p>
                                <h3 class="mt-1 text-base font-semibold text-slate-700">
                                    7 Gallons
                                </h3>
                            </div>
                            <div class="mt-4 flex items-end justify-between gap-3">
                                
                                <div>
                                    <p class="text-xs font-medium text-slate-500">
                                        Price
                                    </p>
                                    <p class="mt-0.5 text-2xl font-bold text-amber-700">
                                        $55
                                    </p>
                                </div>
                                <div class="text-right">
                                    <p class="text-xs font-medium text-slate-500">
                                        Available
                                    </p>
                                    <p class="mt-1 inline-flex min-w-8 justify-center rounded-full bg-white px-2 py-1 text-sm font-bold text-amber-700 shadow-sm ring-1 ring-amber-200">
                                        {mango7Gal["Current Quantity"]}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">
                            Available Varieties
                        </h2>
                      
                    </div>
                    <div class="flex flex-wrap gap-2">
                        {mangoVarieties.map(({ id, name }) => (
                            <button
                                type="button"
                                data-dialog-open={id}
                                class="group flex items-center hover:cursor-pointer gap-1.5 rounded-lg border border-slate-200 bg-slate-100 px-3.5 py-1.5 text-sm font-medium text-slate-700 transition-all hover:border-olive-400 hover:bg-olive-50 hover:text-olive-700 hover:shadow-sm focus:outline-none focus:ring-2 focus:ring-olive-500 focus:ring-offset-1"
                            >
                                {name}
                                <span
                                    class="text-xs text-slate-400 transition-colors group-hover:text-olive-500"
                                    aria-hidden="true"
                                >
                                    ⓘ
                                </span>
                            </button>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </main>
</Layout>
