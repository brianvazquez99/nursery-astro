        aria-hidden="true"
      >ⓘ</span>
    </button>

    <button
      id="kentopen"
      class="group flex items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-100 px-3.5 py-1.5 text-sm font-medium text-slate-700 transition-all hover:border-olive-400 hover:bg-olive-50 hover:text-olive-700 hover:shadow-sm focus:outline-none focus:ring-2 focus:ring-olive-500 focus:ring-offset-1"
    >
      Kent
      <span
        class="text-xs text-slate-400 transition-colors group-hover:text-olive-500"
        aria-hidden="true"
      >ⓘ</span>
    </button>

    <button
      id="superjulioopen"
      class="group flex items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-100 px-3.5 py-1.5 text-sm font-medium text-slate-700 transition-all hover:border-olive-400 hover:bg-olive-50 hover:text-olive-700 hover:shadow-sm focus:outline-none focus:ring-2 focus:ring-olive-500 focus:ring-offset-1"
    >
      Super Julie
      <span
        class="text-xs text-slate-400 transition-colors group-hover:text-olive-500"
        aria-hidden="true"
      >ⓘ</span>
    </button>

    <button
      id="icecreamopen"
      class="group flex items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-100 px-3.5 py-1.5 text-sm font-medium text-slate-700 transition-all hover:border-olive-400 hover:bg-olive-50 hover:text-olive-700 hover:shadow-sm focus:outline-none focus:ring-2 focus:ring-olive-500 focus:ring-offset-1"
    >
      Ice Cream
      <span
        class="text-xs text-slate-400 transition-colors group-hover:text-olive-500"
        aria-hidden="true"
      >ⓘ</span>
    </button>

    <button
