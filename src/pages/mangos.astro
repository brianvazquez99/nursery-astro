---
import background from "../assets/42345.jpg";
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
---

<script>
  const tommyMod: HTMLDialogElement = document.getElementById(
    "tommy",
  ) as HTMLDialogElement;
  const tommyOpen = document.getElementById("tommyopen");
  const tommyClose = document.getElementById("tommyclose");

  tommyOpen?.addEventListener("click", () => {
    tommyMod.showModal();
  });
  tommyClose?.addEventListener("click", () => {
    tommyMod.close();
  });

  const valenciaMod: HTMLDialogElement = document.getElementById(
    "valencia",
  ) as HTMLDialogElement;
  const valenciaOpen = document.getElementById("valenciaprideopen");
  const valenciaClose = document.getElementById("valenciaclose");

  valenciaOpen?.addEventListener("click", () => {
    valenciaMod.showModal();
  });
  valenciaClose?.addEventListener("click", () => {
    valenciaMod.close();
  });

  const glennMod: HTMLDialogElement = document.getElementById(
    "glenn",
  ) as HTMLDialogElement;
  const glennOpen = document.getElementById("glennopen");
  const glennClose = document.getElementById("glennclose");

  glennOpen?.addEventListener("click", () => {
    glennMod.showModal();
  });
  glennClose?.addEventListener("click", () => {
    glennMod.close();
  });

  const kentMod: HTMLDialogElement = document.getElementById(
    "kent",
  ) as HTMLDialogElement;
  const kentOpen = document.getElementById("kentopen");
  const kentClose = document.getElementById("kentclose");

  kentOpen?.addEventListener("click", () => {
    kentMod.showModal();
  });
  kentClose?.addEventListener("click", () => {
    kentMod.close();
  });

  const superjulieMod: HTMLDialogElement = document.getElementById(
    "superjuli",
  ) as HTMLDialogElement;
  const superjulieOpen = document.getElementById("superjulioopen");
  const superjulieClose = document.getElementById("superjuliclose");

  superjulieOpen?.addEventListener("click", () => {
    superjulieMod.showModal();
  });
  superjulieClose?.addEventListener("click", () => {
    superjulieMod.close();
  });

  const icecreamMod: HTMLDialogElement = document.getElementById(
    "icecream",
  ) as HTMLDialogElement;
  const icecreamOpen = document.getElementById("icecreamopen");
  const icecreamClose = document.getElementById("icecreamclose");

  icecreamOpen?.addEventListener("click", () => {
    icecreamMod.showModal();
  });
  icecreamClose?.addEventListener("click", () => {
    icecreamMod.close();
  });

  const carrieMod: HTMLDialogElement = document.getElementById(
    "carrie",
  ) as HTMLDialogElement;
  const carrieOpen = document.getElementById("carrieopen");
  const carrieClose = document.getElementById("carrieclose");

  carrieOpen?.addEventListener("click", () => {
    carrieMod.showModal();
  });
  carrieClose?.addEventListener("click", () => {
    carrieMod.close();
  });

  const namdocmaiMod: HTMLDialogElement = document.getElementById(
    "namdocmai",
  ) as HTMLDialogElement;
  const namdocmaiOpen = document.getElementById("namdocmaioopen");
  const namdocmaiClose = document.getElementById("namdocmaiclose");

  namdocmaiOpen?.addEventListener("click", () => {
    namdocmaiMod.showModal();
  });
  namdocmaiClose?.addEventListener("click", () => {
    namdocmaiMod.close();
  });
</script>

<Layout>
  <main class="w-full max-w-6xl mx-auto px-4 py-8 lg:py-12">
<dialog
  id="tommy"
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-emerald-100 bg-white p-0 shadow-2xl backdrop:bg-slate-900/50"
>
  <div class="flex flex-col">
    <div class="flex items-start justify-between border-b border-slate-100 px-6 py-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-emerald-600">Mango Variety</p>
        <h3 class="mt-1 text-xl font-bold text-slate-900">Tommy Atkins</h3>
      </div>

      <button
        id="tommyclose"
        type="button"
        aria-label="Close Tommy Atkins dialog"
        class="rounded-full p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500"
      >
        ✕
      </button>
    </div>

    <div class="px-6 py-5">
      <p class="text-sm leading-6 text-slate-600">
        Commercially produced mango, widely known for its exceptional durability
        and long shelf life.
      </p>

      <a
        href="https://en.wikipedia.org/wiki/Tommy_Atkins_(mango)"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-emerald-600 transition hover:text-emerald-700 hover:underline"
      >
        Learn more <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</dialog>


<dialog
  id="valencia"
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-emerald-100 bg-white p-0 shadow-2xl backdrop:bg-slate-900/50"
>
  <div class="flex flex-col">
    <div class="flex items-start justify-between border-b border-slate-100 px-6 py-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-emerald-600">Mango Variety</p>
        <h3 class="mt-1 text-xl font-bold text-slate-900">Valencia Pride</h3>
      </div>

      <button
        id="valenciaclose"
        type="button"
        aria-label="Close Valencia Pride dialog"
        class="rounded-full p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500"
      >
        ✕
      </button>
    </div>

    <div class="px-6 py-5">
      <p class="text-sm leading-6 text-slate-600">
        A large, fast-growing classic Florida mango variety known for its
        vibrant red-and-yellow skin and sweet, nearly fiberless flesh.
      </p>
    </div>
  </div>
</dialog>


<dialog
  id="glenn"
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-emerald-100 bg-white p-0 shadow-2xl backdrop:bg-slate-900/50"
>
  <div class="flex flex-col">
    <div class="flex items-start justify-between border-b border-slate-100 px-6 py-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-emerald-600">Mango Variety</p>
        <h3 class="mt-1 text-xl font-bold text-slate-900">Glenn</h3>
      </div>

      <button
        id="glennclose"
        type="button"
        aria-label="Close Glenn dialog"
        class="rounded-full p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500"
      >
        ✕
      </button>
    </div>

    <div class="px-6 py-5">
      <p class="text-sm leading-6 text-slate-600">
        A classic, early-season Florida variety known for its rich, sweet
        flavor and smooth, entirely fiberless flesh.
      </p>
    </div>
  </div>
</dialog>


<dialog
  id="kent"
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-emerald-100 bg-white p-0 shadow-2xl backdrop:bg-slate-900/50"
>
  <div class="flex flex-col">
    <div class="flex items-start justify-between border-b border-slate-100 px-6 py-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-emerald-600">Mango Variety</p>
        <h3 class="mt-1 text-xl font-bold text-slate-900">Kent</h3>
      </div>

      <button
        id="kentclose"
        type="button"
        aria-label="Close Kent dialog"
        class="rounded-full p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500"
      >
        ✕
      </button>
    </div>

    <div class="px-6 py-5">
      <p class="text-sm leading-6 text-slate-600">
        A large, sweet, fiberless variety of mango known for its rich flavor
        and juicy, tender flesh.
      </p>

      <a
        href="https://www.mango.org/mango-variety/kent/"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-emerald-600 transition hover:text-emerald-700 hover:underline"
      >
        Learn more <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</dialog>


<dialog
  id="superjuli"
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-emerald-100 bg-white p-0 shadow-2xl backdrop:bg-slate-900/50"
>
  <div class="flex flex-col">
    <div class="flex items-start justify-between border-b border-slate-100 px-6 py-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-emerald-600">Mango Variety</p>
        <h3 class="mt-1 text-xl font-bold text-slate-900">Super Julie</h3>
      </div>

      <button
        id="superjuliclose"
        type="button"
        aria-label="Close Super Julie dialog"
        class="rounded-full p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500"
      >
        ✕
      </button>
    </div>

    <div class="px-6 py-5">
      <p class="text-sm leading-6 text-slate-600">
        A premium, highly flavorful mango variety developed from a Julie mango
        seedling by breeder Gary Zill in Boynton Beach, Florida.
      </p>
    </div>
  </div>
</dialog>


<dialog
  id="icecream"
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-emerald-100 bg-white p-0 shadow-2xl backdrop:bg-slate-900/50"
>
  <div class="flex flex-col">
    <div class="flex items-start justify-between border-b border-slate-100 px-6 py-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-emerald-600">Mango Variety</p>
        <h3 class="mt-1 text-xl font-bold text-slate-900">Ice Cream</h3>
      </div>

      <button
        id="icecreamclose"
        type="button"
        aria-label="Close Ice Cream dialog"
        class="rounded-full p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500"
      >
        ✕
      </button>
    </div>

    <div class="px-6 py-5">
      <p class="text-sm leading-6 text-slate-600">
        A small, dwarf-tree mango variety originating from Trinidad that is
        famous for its exceptionally smooth, fiberless flesh and sweet flavor
        reminiscent of mango sorbet.
      </p>
    </div>
  </div>
</dialog>


<dialog
  id="carrie"
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-emerald-100 bg-white p-0 shadow-2xl backdrop:bg-slate-900/50"
>
  <div class="flex flex-col">
    <div class="flex items-start justify-between border-b border-slate-100 px-6 py-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-emerald-600">Mango Variety</p>
        <h3 class="mt-1 text-xl font-bold text-slate-900">Carrie</h3>
      </div>

      <button
        id="carrieclose"
        type="button"
        aria-label="Close Carrie dialog"
        class="rounded-full p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500"
      >
        ✕
      </button>
    </div>

    <div class="px-6 py-5">
      <p class="text-sm leading-6 text-slate-600">
        A longtime favorite among mango enthusiasts for its incredibly rich,
        sweet flavor, buttery texture, and superb disease resistance.
      </p>

      <a
        href="https://www.louiesnursery.com/plants/tropical-fruit-trees/mango-trees/carrie-mango/"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-emerald-600 transition hover:text-emerald-700 hover:underline"
      >
        Learn more <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</dialog>


<dialog
  id="namdocmai"
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-emerald-100 bg-white p-0 shadow-2xl backdrop:bg-slate-900/50"
>
  <div class="flex flex-col">
    <div class="flex items-start justify-between border-b border-slate-100 px-6 py-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-emerald-600">Mango Variety</p>
        <h3 class="mt-1 text-xl font-bold text-slate-900">Nam Doc Mai</h3>
      </div>

      <button
        id="namdocmaiclose"
        type="button"
        aria-label="Close Nam Doc Mai dialog"
        class="rounded-full p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-500"
      >
        ✕
      </button>
    </div>

    <div class="px-6 py-5">
      <p class="text-sm leading-6 text-slate-600">
        Originating from Thailand, this mango is known for its exceptional
        sweetness, silky texture, and use in traditional dishes like Thai
        mango sticky rice.
      </p>

      <a
        href="https://toptropicals.com/cgi-bin/garden_catalog/cat.cgi?script_param=dWlkPU1BTkdPX05BTURPQ01BSQ==&print_page=1"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-emerald-600 transition hover:text-emerald-700 hover:underline"
      >
        Learn more <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</dialog>


    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">
      <!-- Plant Media Section -->
      <div
        class="relative w-full aspect-square sm:aspect-[4/3] lg:aspect-square rounded-2xl overflow-hidden shadow-lg border border-slate-100 bg-slate-50"
      >
        <img
          src={background.src}
          alt="Avocado tree foliage and fruit"
          class="w-full h-full object-cover object-center"
        />
      </div>

      <!-- Details & Specs Section -->
      <div class="flex flex-col gap-6">
        <!-- Category & Title -->
        <div>
          <span
            class="text-xs font-semibold tracking-wider text-amber-700 uppercase"
            >Fruit Trees</span
          >
          <h1
            class="text-3xl sm:text-4xl font-bold text-olive-600 tracking-tight mt-1"
          >
            Mango
          </h1>
          <p class="italic text-slate-500 mt-0.5">Mangifera indica</p>
          <p class="text-sm font-medium italic text-slate-500 mt-0.5">
            Grown for its large, colorful and delicious fruit, the medium to
            large evergreen mango tree is also attractive in the home landscape.
            Its rounded canopy may be low and dense to upright and open, with
            dark green foliage that is long and narrow.
          </p>
        </div>

        <!-- Pricing Breakdown Cards -->
        <div class="space-y-2">
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">
            Pot Size & Pricing
          </h2>
          <div class="grid grid-cols-2 gap-3">
            <div
              class="flex flex-col p-4 rounded-xl border border-olive-200 bg-olive-50/50"
            >
              <span class="text-xs font-medium text-slate-600"
                >3 Gallon Container</span
              >
              <span class="text-2xl font-bold text-olive-700 mt-1">$30</span>
            </div>
            <div
              class="flex flex-col p-4 rounded-xl border border-amber-200 bg-amber-50/50"
            >
              <span class="text-xs font-medium text-slate-600"
                >7 Gallon Container</span
              >
              <span class="text-2xl font-bold text-amber-700 mt-1">$55</span>
            </div>
          </div>
        </div>

   <!-- Varieties Grid -->
<div class="space-y-3">
  <div class="flex items-center justify-between">
    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">
      Available Varieties
    </h2>

    <span class="flex items-center gap-1.5 text-xs text-slate-400">
      <span
        class="flex h-5 w-5 items-center justify-center rounded-full bg-olive-50 text-olive-600"
        aria-hidden="true"
      >
        i
      </span>
      Click a variety for more info
    </span>
  </div>

  <div class="flex flex-wrap gap-2">
    <button
      id="tommyopen"
      class="group flex items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-100 px-3.5 py-1.5 text-sm font-medium text-slate-700 transition-all hover:border-olive-400 hover:bg-olive-50 hover:text-olive-700 hover:shadow-sm focus:outline-none focus:ring-2 focus:ring-olive-500 focus:ring-offset-1"
    >
      Tommy Atkins
      <span
        class="text-xs text-slate-400 transition-colors group-hover:text-olive-500"
        aria-hidden="true"
      >ⓘ</span>
    </button>

    <button
      id="valenciaprideopen"
      class="group flex items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-100 px-3.5 py-1.5 text-sm font-medium text-slate-700 transition-all hover:border-olive-400 hover:bg-olive-50 hover:text-olive-700 hover:shadow-sm focus:outline-none focus:ring-2 focus:ring-olive-500 focus:ring-offset-1"
