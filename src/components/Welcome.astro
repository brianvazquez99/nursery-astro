---
import astroLogo from '../assets/astro.svg';
import background from '../assets/nursery-thumbnail.jpg';
---

<div class="w-full flex flex-col min-h-screen">
  <!-- Hero Container -->
  <header class="relative w-full min-h-[60vh] flex items-center justify-center text-center p-6 overflow-hidden">
    <!-- Blurred Background with fixed aspect ratio via object-cover -->
    <img
      id="background"
      src={background.src}
      alt="Fruit tree hero background"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover  blur-[2px] scale-105 z-0"
    />
    <!-- Dark Overlay for Readability -->
    <div class="absolute inset-0 bg-black/30 z-0"></div>

    <!-- Hero Content -->
    <main id="hero" class="relative z-10 flex flex-col items-center gap-4 max-w-xl">
      <h1 class="text-2xl sm:text-4xl font-bold text-white tracking-tight drop-shadow-sm">
        Fruit Trees grown by family
      </h1>
      <a href="#collection">
        <button class="bg-amber-700 hover:bg-amber-800 text-white px-5 py-2.5 rounded-md font-semibold transition-colors shadow-md">
          Explore our Collections
        </button>
      </a>
    </main>
  </header>

  <!-- Collection Section -->
  <section id="collection" class="w-full max-w-7xl mx-auto px-4 py-10 flex-1">
    <h2 class="text-2xl sm:text-3xl font-semibold text-center text-olive-600 underline decoration-amber-700 decoration-2 underline-offset-8 mb-8">
      Collection
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Collection Card 1 -->
      <a href="/mangos" class="group relative h-[220px] w-full rounded-lg overflow-hidden shadow-md block">
        <img
          class="w-full h-full object-cover object-center opacity-70 mix-blend-multiply transition-transform duration-300 group-hover:scale-105"
          src={background.src}
          alt="Mango collection"
        />
        <div class="absolute inset-0 bg-black/20"></div>
        <span class="absolute bottom-4 inset-x-0 font-semibold text-xl text-white text-center z-10">
          Mango
        </span>
      </a>

      <!-- Collection Card 2 -->
      <a href="/mangos" class="group relative h-[220px] w-full rounded-lg overflow-hidden shadow-md block">
        <img
          class="w-full h-full object-cover object-center opacity-70 mix-blend-multiply transition-transform duration-300 group-hover:scale-105"
          src={background.src}
          alt="Mango collection"
        />
        <div class="absolute inset-0 bg-black/20"></div>
        <span class="absolute bottom-4 inset-x-0 font-semibold text-xl text-white text-center z-10">
          Mango
        </span>
      </a>

      <!-- Collection Card 3 -->
      <a href="/mangos" class="group relative h-[220px] w-full rounded-lg overflow-hidden shadow-md block">
        <img
          class="w-full h-full object-cover object-center opacity-70 mix-blend-multiply transition-transform duration-300 group-hover:scale-105"
          src={background.src}
          alt="Mango collection"
        />
        <div class="absolute inset-0 bg-black/20"></div>
        <span class="absolute bottom-4 inset-x-0 font-semibold text-xl text-white text-center z-10">
          Mango
        </span>
      </a>
    </div>
  </section>
</div>

