---
import astroLogo from '../assets/astro.svg';
import background from '../assets/42345.jpg';
---

<div class="flex flex-col h-full w-full">

	<div id="container" class="flex flex-col  h-[80%] relative">
		<img id="background" src={background.src} alt="" fetchpriority="high" />
		<main class="flex justify-center items-center h-[80%]">
			<section id="hero">

				<h1 class="text-lg font-bold text-olive-100">
					Fruit Trees grown by family
				</h1>
				<a href="#collection">
					<button class="bg-yellow-700 text-olive-100 px-2 py-1 rounded font-semibold">
						Explore our Collections
					</button>
				</a>
			</section>
		</main>


	</div>
	<div id="collection" class="w-full flex-1 flex-col flex-1">
		<h3 class="text-2xl font-semibold text-center text-olive-600 underline decoration-amber-700">
			Collection
		</h3>
		<div class="flex gap-3 items-center">
			<div class="relative">
				<img class="rounded opacity-90 absolute top-0 left-0 -z-1 h-[200px] w-[300px]"  src={background.src} alt="" fetchpriority="high" />
				Mango
			</div>

		</div>
</div>
</div>

<style>
	#background {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 80%;
		z-index: -1;
		filter: blur(2px);
	}

	#container {
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
	}


	#hero {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 16px;
	}

	h1 {
		font-size: 22px;
		margin-top: 0.25em;
	}




	@media screen and (max-width: 768px) {
		#container {
			display: flex;
			flex-direction: column;
		}

		#hero {
			display: block;
			padding-top: 10%;
		}


		h1 {
			line-height: 1.5;
		}
	}
</style>
